---
// A terminal window. Lines are real text so the content stays in the DOM.
interface Props {
  x: number; y: number; w: number; h: number; title: string; lines: string[];
  state?: string; class?: string; cursor?: boolean; tag?: string; tagState?: string; size?: number;
}
const { x, y, w, h, title, lines, state = 'idle', class: cls, cursor = true, tag, tagState = 'fail', size = 14 } = Astro.props;
const lh = size + 7;
---
<g class:list={['term', cls]} data-state={state} transform={`translate(${x} ${y})`}>
  <rect class="panel" width={w} height={h} rx="6" />
  <rect width={w} height="26" rx="6" fill="var(--steel-1)" />
  <rect y="14" width={w} height="12" fill="var(--steel-1)" />
  <circle cx="14" cy="13" r="3.5" fill="var(--stop)" opacity=".7" />
  <circle cx="28" cy="13" r="3.5" fill="var(--planner)" opacity=".7" />
  <circle cx="42" cy="13" r="3.5" fill="var(--ok)" opacity=".7" />
  <text x="58" y="17" class="t-sm t-nocase">{title}</text>
  {lines.map((l, i) => <text x="14" y={46 + i * lh} class="t-nocase" style={`font-size:${size}px`} fill="var(--fg-dim)">{l}</text>)}
  {cursor && <rect class="cursor-blink" x="14" y={46 + lines.length * lh - size + 2} width="8" height={size} fill="var(--c, var(--accent))" />}
  {tag && (
    <g data-state={tagState} class="term__tag">
      <rect x={w - 4} y="-16" width={tag.length * 9.4 + 22} height="22" rx="2" transform={`translate(${-(tag.length * 9.4 + 18)} 0)`} fill="var(--c)" />
      <text x={w - 12} y="-1" text-anchor="end" style="font-size:12px;fill:#0b0e12;font-weight:700">{tag}</text>
    </g>
  )}
</g>
