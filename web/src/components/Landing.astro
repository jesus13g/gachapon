---
import Base from '../layouts/Base.astro';
import ThreadLayer from './ThreadLayer.astro';
import { copyFor } from '../i18n';
import Hud from './Hud.astro';
import Footer from './Footer.astro';
import Act00Boot from './scenes/Act00Boot.astro';
import Act01Problem from './scenes/Act01Problem.astro';
import Act02Roles from './scenes/Act02Roles.astro';
import Act03Bus from './scenes/Act03Bus.astro';
import Act04Locks from './scenes/Act04Locks.astro';
import Act05Modes from './scenes/Act05Modes.astro';
import Act06Control from './scenes/Act06Control.astro';
import Act07Teams from './scenes/Act07Teams.astro';
import Act08Routines from './scenes/Act08Routines.astro';
import Act09Knowledge from './scenes/Act09Knowledge.astro';
import Act10Mcp from './scenes/Act10Mcp.astro';
import Act11Sandbox from './scenes/Act11Sandbox.astro';
import Act12Journal from './scenes/Act12Journal.astro';
import Act13Interfaces from './scenes/Act13Interfaces.astro';
import Act14System from './scenes/Act14System.astro';
import Act15Final from './scenes/Act15Final.astro';
const { acts, ui } = copyFor(Astro.currentLocale);
---
<Base>
  <Hud page="landing" />
  <nav class="rail" aria-label={ui.railLabel}>
    {acts.map((a, i) => <button type="button" aria-label={a.kicker} aria-current={i === 0 ? 'true' : 'false'}><span>{a.kicker}</span></button>)}
  </nav>
  <main id="story" class="story">
    <div class="stage">
      <div class="stage__grid"></div>
      <Act00Boot />
      <Act01Problem />
      <Act02Roles />
      <Act03Bus />
      <Act04Locks />
      <Act05Modes />
      <Act06Control />
      <Act07Teams />
      <Act08Routines />
      <Act09Knowledge />
      <Act10Mcp />
      <Act11Sandbox />
      <Act12Journal />
      <Act13Interfaces />
      <Act14System />
      <Act15Final />
      <ThreadLayer />
      <div class="stage__vignette"></div>
    </div>
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</Base>
