---
// Top header shared by the landing, the architecture page and the blog.
// The pill buttons lead to the other two views; the language switch keeps the current page (and blog article).
import { copyFor, langOf, pathFor, type Page } from '../i18n';

interface Props {
  page: Page;
  /** Blog article on screen, so the language switch opens the same one. */
  slug?: string;
}
const { page, slug } = Astro.props;
const { site, ui, architecture, blog } = copyFor(Astro.currentLocale);
const lang = langOf(Astro.currentLocale);
const other = lang === 'es' ? 'en' : 'es';
const onLanding = page === 'landing';
const label: Record<Page, string> = { landing: architecture.back, architecture: architecture.nav, blog: blog.nav };
const views = (['landing', 'architecture', 'blog'] as const).filter((v) => v !== page);
---
<header class="hud">
  <a class="brand" href={onLanding ? '#boot' : pathFor(lang)} aria-label={onLanding ? ui.top : ui.home}>
    <svg viewBox="0 0 30 18" aria-hidden="true"><path d="M15 1H9a8 8 0 0 0 0 16h6z" fill="#ff9a3c" /><path d="M15 1h6a8 8 0 0 1 0 16h-6z" fill="#f1f0ea" /></svg>
    <span class="brand__word">Gachapon</span>
  </a>
  <slot name="index" />
  <nav class="hud__links" aria-label={ui.navProject}>
    {views.map((v) => (
      <a class="nav-pill" href={pathFor(lang, v)} title={label[v]}>
        {v === 'landing' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h8" /></svg>}
        {v === 'architecture' && <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3.5" cy="8" r="1.8" /><circle cx="12.5" cy="3.5" r="1.8" /><circle cx="12.5" cy="12.5" r="1.8" /><path d="M5.2 7.2l5.6-3M5.2 8.8l5.6 3" /></svg>}
        {v === 'blog' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h7.5L13 4.5V14H3z" /><path d="M5.5 7h5M5.5 9.5h5M5.5 12h3" /></svg>}
        <span>{label[v]}</span>
      </a>
    ))}
    <a class="lang-switch" href={pathFor(other, page, slug)} hreflang={other} lang={other} title={ui.langSwitch} aria-label={`${other} · ${ui.langSwitch}`} data-lang-switch={onLanding ? '' : undefined}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M1.5 8h13M8 1.5c2 2 2.6 4.2 2.6 6.5S10 12.5 8 14.5M8 1.5C6 3.5 5.4 5.7 5.4 8S6 12.5 8 14.5" /></svg>
      {other}
    </a>
    <a class="hud__gh" href={site.repo} rel="noopener">GitHub</a>
  </nav>
</header>
