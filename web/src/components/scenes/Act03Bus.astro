---
import Scene from '../Scene.astro';
import FlowPath from '../FlowPath.astro';
import Station from '../Station.astro';
import Capsule from '../Capsule.astro';
import { tr } from '../../i18n';
const t = tr(Astro.currentLocale);
---
<Scene i={3}>
  <rect data-k="shell" class="panel dash" x="90" y="300" width="1420" height="520" rx="26" />

  <FlowPath id="bus-loop" d="M180 410 H1240 Q1310 410 1310 480 V580 Q1310 650 1240 650 H180" state="active" />
  <path id="bus-intake" d="M800 500 Q 520 500 360 410" fill="none" stroke="none" />
  <g data-k="spurs">
    <path class="wire dash" d="M580 444 V496" /><path class="wire dash" d="M1020 444 V496" />
  </g>
  <g data-k="bus-labels">
    <text class="t-sm" x="1490" y="330" text-anchor="end">{t('inside gachapon · the job bus')}</text>
    <text class="t-sm" x="196" y="452" style="fill:var(--exec)">{t('executor queue →')}</text>
    <text class="t-sm" x="1290" y="590" text-anchor="end" style="fill:var(--planner)">{t('← planner review queue')}</text>
  </g>

  <g data-k="stn" data-s="queued"><Station x={360} y={410} label={t('QUEUED')} sub={t('waiting its turn')} state="idle" hint={t('Queued: in the executor’s queue, oldest first.')} /></g>
  <g data-k="stn" data-s="running"><Station x={800} y={410} label={t('RUNNING')} sub={t('executor at work')} state="idle" hint={t('Running: the executor holds the worktree and the agent is working.')} /></g>
  <g data-k="stn" data-s="review"><Station x={1100} y={650} label={t('REVIEW')} sub={t('planner judges')} state="idle" below hint={t('Review: delivered with a report; waits for the planner.')} /></g>
  <g data-k="stn" data-s="closed"><Station x={360} y={650} label={t('CLOSED')} sub={t('verified · done')} state="idle" below hint={t('Closed: something verifiable passed.')} /></g>
  <g data-k="bay" data-s="waiting"><Station x={580} y={530} w={190} label={t('WAITING')} sub={t('correction package · for you')} state="wait" below hint={t('Waiting: a failed routine’s correction package, until you confirm.')} /></g>
  <g data-k="bay" data-s="cancelled"><Station x={1020} y={530} w={190} label={t('CANCELLED')} sub={t('really stopped')} state="fail" below hint={t('Cancelled: the agent is stopped for real; what it wrote stays.')} /></g>
  <Capsule class="ghost" x={580} y={536} s={0.5} state="wait" />
  <Capsule class="ghost" x={1020} y={536} s={0.5} state="fail" />

  <g data-k="queue-line">
    <Capsule x={196} y={410} s={0.5} state="idle" /><Capsule x={236} y={410} s={0.5} state="idle" />
  </g>
  <text data-k="bus-note" class="t-md t-fg" x="800" y="770" text-anchor="middle">{t('NEVER LOST. ALWAYS IN A KNOWN STATE.')}</text>
</Scene>
