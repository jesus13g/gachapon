---
import Scene from '../Scene.astro';
import FlowPath from '../FlowPath.astro';
import TimelineEvent from '../TimelineEvent.astro';
const evs = ['JOB QUEUED', 'RUN STARTED', 'SKILLS INJECTED', 'PHASE DONE', 'REVIEW', 'RESULT: OK', 'ROUTINE RUN', 'PROPOSAL ACCEPTED', 'CORRECTION', 'USER NOTE'];
const subs = ['planner', 'executor', 'job #skills', 'diff saved', 'planner', 'closed?', 'calendar', 'by you', 'new event', 'by you'];
const X = (i: number) => 160 + i * 145;
const fields = ['JOB', 'AGENT', 'MODEL', 'SKILLS', 'PHASES', 'DIFF', 'RESULT', 'USER', 'TIMESTAMP'];
const cx = 595, cy = 560;
const src = ['JOBS', 'ROUTINES', 'PROPOSALS', 'SETTINGS'];
---
<Scene i={12}>
  <FlowPath id="jr-line" d="M80 560 H1700" state="active" />
  <g data-k="ticks">
    {Array.from({ length: 26 }, (_, i) => <path d={`M${110 + i * 60} 548 V572`} stroke="var(--line-hi)" stroke-width="1.5" />)}
  </g>
  <text class="t-sm" x="1500" y="602" text-anchor="end" style="fill:var(--accent)" data-k="append">append only →</text>

  <g data-k="emit">
    {src.map((s, i) => (
      <g>
        <text class="t-sm" x={880 + i * 170} y="212" text-anchor="middle">{s}</text>
        <path class="emit" d={`M${880 + i * 170} 228 V${i % 2 ? 540 : 536}`} stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 8" />
      </g>
    ))}
  </g>

  {evs.map((e, i) => <g data-k="ev" data-i={i}><TimelineEvent x={X(i)} y={560} label={e} sub={subs[i]} up={i % 2 === 0} w={132} state={i === 8 ? 'active' : i === 5 ? 'wait' : 'idle'} /></g>)}

  <g data-k="spokes">
    {fields.map((f, i) => {
      const a = (i / fields.length) * Math.PI * 2 - Math.PI / 2;
      const x = cx + Math.cos(a) * 245, y = cy + Math.sin(a) * 150;
      return (
        <g>
          <path d={`M${cx} ${cy} L${x} ${y}`} stroke="var(--accent)" stroke-opacity=".6" stroke-width="1.5" />
          <g transform={`translate(${x - 56} ${y - 17})`}><rect width="112" height="34" rx="4" class="panel-hi" style="stroke:var(--accent)" /><text class="t-sm t-fg" x="56" y="22" text-anchor="middle" style="font-size:12px">{f}</text></g>
        </g>
      );
    })}
  </g>

  <path data-k="corr-arc" d={`M${X(8)} 548 C ${X(8)} 460 ${X(5)} 460 ${X(5)} 548`} fill="none" stroke="var(--accent)" stroke-width="2.4" marker-end="url(#m-arrow)" />
  <text data-k="corr-t" class="t-sm" x={(X(8) + X(5)) / 2} y="458" text-anchor="middle" style="fill:var(--accent)">corrects · original stays</text>
</Scene>
