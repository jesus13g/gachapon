---
import Scene from '../Scene.astro';
import MachineArt from '../MachineArt.astro';
import Capsule from '../Capsule.astro';
import { ui } from '../../content/copy.en';
const h = ui.hero;
---
<Scene i={0} thread={false} copy={false}>
  <g data-k="hero-bus" opacity="0.9">
    <path class="wire-dim" d="M520 690 H80" />
    <path class="wire-dim" d="M1560 690 H1600" />
  </g>
  <MachineArt k="machine" />
  <Capsule class="static-capsule" x={1130} y={330} s={1.35} rot={-24} state="active" />
  <g data-k="boot-term" transform="translate(90 150)" class="boot-term">
    {h.boot.map((l, n) => (
      <g class="boot-line" data-n={n}>
        <circle cx="6" cy={n * 22 + 70} r="3.5" class="led" data-state="ok" />
        <text x="20" y={n * 22 + 75} class="t-sm t-nocase">{l}</text>
      </g>
    ))}
    <text x="0" y="46" class="t-sm" style="fill:var(--accent)">$ ea status</text>
  </g>
  <div slot="copy" class="hero-copy">
    <span class="brandmark">Gachapon</span>
    <h1 id="boot-title">Turn AI agents <em>into a system.</em></h1>
    <p class="sub"><strong>The expensive model thinks. The local model works.</strong> Gachapon coordinates them — and you keep control.</p>
    <span class="scroll-cue" aria-hidden="true"><i></i>Scroll</span>
  </div>
</Scene>
