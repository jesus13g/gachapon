---
// Architecture view: one embedded interactive diagram per section.
// Diagram HTML is generated by the archify skill into public/architecture/<lang>/<slug>.html (see web/README.md).
import Base from '../layouts/Base.astro';
import Hud from './Hud.astro';
import Footer from './Footer.astro';
import { copyFor, langOf } from '../i18n';

const { architecture: a } = copyFor(Astro.currentLocale);
const lang = langOf(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (slug: string) => `${base}/architecture/${lang}/${slug}.html`;
// Frame height per diagram: 'tall' for the long tree, the 39-message sequence and the dense maps; 'compact' for the short, wide ones.
const size: Record<string, 'tall' | 'compact'> = {
  system: 'tall',
  workspace: 'tall',
  'mission-flow': 'tall',
  'planner-executor': 'tall',
  platform: 'tall',
  'job-lifecycle': 'compact',
  database: 'compact',
};
// `identifier` markers in the copy render as <code>.
const parts = (s: string) => s.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
---
<Base title={a.title} description={a.description} page="architecture">
  <Hud page="architecture" />
  <main id="story" class="arch">
    <header class="arch-hero">
      <p class="kicker">{a.kicker}</p>
      <h1>{a.h1}</h1>
      <div class="arch-hero__intro">
        {a.intro.map((t) => <p>{t}</p>)}
      </div>
      <aside class="arch-howto">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 7.2v4M8 4.6v.1" /></svg>
        <p><strong>{a.howTo.label}.</strong> {a.howTo.text}</p>
      </aside>
    </header>

    <nav class="arch-index" aria-label={a.indexLabel}>
      <ol>
        {a.sections.map((s) => <li><a href={`#${s.slug}`} data-sec={s.slug} title={s.kicker}>{s.short}</a></li>)}
      </ol>
    </nav>

    {a.sections.map((s) => (
      <section class="arch-sec" id={s.slug} aria-labelledby={`${s.slug}-h`}>
        <div class="arch-sec__copy">
          <div class="arch-sec__head">
            <p class="kicker">{s.kicker}</p>
            <h2 id={`${s.slug}-h`}>{s.h}</h2>
            <p class="arch-sec__lede">{parts(s.p).map((x) => (x.code ? <code>{x.text}</code> : x.text))}</p>
          </div>
          <ul>
            {s.points.map((pt) => <li>{parts(pt).map((x) => (x.code ? <code>{x.text}</code> : x.text))}</li>)}
          </ul>
        </div>
        <figure class={`arch-frame${size[s.slug] ? ` arch-frame--${size[s.slug]}` : ''}`}>
          <span class="arch-frame__tag arch-frame__tag--tl">{s.kicker}</span>
          <span class="arch-frame__tag arch-frame__tag--tr">{a.frameLabel}</span>
          <div class="arch-frame__screen">
            <span class="arch-frame__loading" aria-hidden="true">{a.loading}</span>
            <iframe
              src={`${src(s.slug)}?theme=dark&embed=1`}
              title={`${a.diagramTitle}: ${s.h}`}
              loading="lazy"
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
          <a class="arch-frame__open" href={`${src(s.slug)}?theme=dark`} target="_blank" rel="noopener">
            {a.fullscreen}
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5l-6 6M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" /></svg>
          </a>
        </figure>
      </section>
    ))}
  </main>
  <Footer />
</Base>

<script>
  // Highlight the chip of the section in view; smooth scrolling unless the visitor prefers reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const chips = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.arch-index a[data-sec]').forEach((c) => chips.set(c.dataset.sec!, c));
  const setActive = (slug: string) => {
    chips.forEach((c, k) => {
      if (k === slug) {
        c.setAttribute('aria-current', 'true');
        const nav = c.closest<HTMLElement>('.arch-index')!;
        if (nav.scrollWidth > nav.clientWidth) {
          nav.scrollTo({ left: c.offsetLeft - nav.clientWidth / 2 + c.offsetWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
        }
      } else c.removeAttribute('aria-current');
    });
  };
  const secs = Array.from(document.querySelectorAll<HTMLElement>('.arch-sec'));
  if ('IntersectionObserver' in window && secs.length) {
    const io = new IntersectionObserver(
      () => {
        const line = window.innerHeight * 0.35;
        let cur = '';
        for (const s of secs) if (s.getBoundingClientRect().top <= line) cur = s.id;
        setActive(cur);
      },
      { rootMargin: '-35% 0px -64% 0px', threshold: [0, 1] },
    );
    secs.forEach((s) => io.observe(s));
  }
  chips.forEach((c, slug) =>
    c.addEventListener('click', (e) => {
      const target = document.getElementById(slug);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${slug}`);
    }),
  );
</script>

<style>
  /* Architecture page: normal scrolling document on the shared tokens (no pinned stage). */
  .arch {
    position: relative;
    z-index: 9;
    padding: clamp(88px, 12vh, 130px) var(--gutter) clamp(48px, 8vh, 96px);
    max-width: 1480px;
    margin: 0 auto;
  }
  /* The diagrams scroll under the fixed header: make its backdrop denser than the landing's so they never show through the brand and buttons. */
  :global(html:not(.is-cinema) body .hud) {
    background: linear-gradient(var(--bg) 75%, transparent);
  }
  .arch-hero {
    max-width: 52rem;
  }
  .arch-hero h1 {
    margin: 0 0 1.2rem;
    font: 800 clamp(2.6rem, 7vw, 5.6rem) / 0.9 var(--display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .arch-hero__intro p {
    margin: 0 0 0.9rem;
    max-width: 44rem;
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .arch-howto {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 1.6rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--steel-0) 70%, transparent);
  }
  .arch-howto svg {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .arch-howto p {
    margin: 0;
    font: 400 0.82rem / 1.6 var(--mono);
    color: var(--fg-dim);
  }
  .arch-howto strong {
    color: var(--fg);
    font-weight: 600;
  }

  /* Section index: sticky chips under the header; wraps on desktop, scrolls with a fade edge on mobile */
  .arch-index {
    position: sticky;
    top: 56px;
    z-index: 20;
    margin: 2.4rem calc(var(--gutter) * -1) 0;
    padding: 10px var(--gutter);
    background: linear-gradient(var(--bg) 70%, transparent);
  }
  .arch-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .arch-index a {
    display: block;
    padding: 5px 11px;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--fg-dim);
    background: var(--shader-veil);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .arch-index a:hover,
  .arch-index a:focus-visible {
    color: var(--fg);
    border-color: var(--accent);
  }
  .arch-index a[aria-current] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 760px) {
    .arch-index {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent);
    }
    .arch-index::-webkit-scrollbar {
      display: none;
    }
    .arch-index ol {
      flex-wrap: nowrap;
      width: max-content;
      padding-right: 36px;
    }
  }

  /* One section per diagram: text on top (lede left, key facts right), panel across the full width */
  .arch-sec {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    padding-top: clamp(2.6rem, 7vh, 5rem);
    scroll-margin-top: 90px;
  }
  .arch-sec__copy {
    display: grid;
    gap: 1.2rem clamp(1.6rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 1000px) {
    .arch-sec__copy {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  .arch-sec__copy h2 {
    margin: 0 0 1rem;
    font: 800 clamp(1.9rem, 3.4vw, 3rem) / 0.95 var(--display);
    text-transform: uppercase;
  }
  .arch-sec__lede {
    margin: 0;
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .arch-sec__copy code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    font: 500 0.86em var(--mono);
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .arch-sec__copy ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .arch-sec__copy li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .arch-sec__copy li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  /* Diagram panel: part of the machine, steel frame with an inner glow and mono corner labels */
  .arch-frame {
    position: relative;
    margin: 0;
    padding: 30px 12px 12px;
    border: 1px solid var(--line-hi);
    background: linear-gradient(160deg, var(--steel-1), var(--steel-0));
    box-shadow: inset 0 0 40px color-mix(in srgb, var(--accent) 6%, transparent), 0 18px 50px rgba(0, 0, 0, 0.45);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }
  .arch-frame__tag {
    position: absolute;
    top: 9px;
    font: 500 0.62rem var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .arch-frame__tag--tl {
    left: 14px;
    color: var(--accent);
  }
  .arch-frame__tag--tr {
    right: 26px;
  }
  .arch-frame__screen {
    position: relative;
    height: min(74vh, 720px);
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.6);
  }
  .arch-frame--tall .arch-frame__screen {
    height: min(88vh, 900px);
  }
  .arch-frame--compact .arch-frame__screen {
    height: min(62vh, 600px);
  }
  .arch-frame__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 500 0.72rem var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
    animation: arch-pulse 1.6s ease-in-out infinite;
  }
  .arch-frame__screen iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .arch-frame__open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 4px 2px;
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-dim);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .arch-frame__open:hover,
  .arch-frame__open:focus-visible {
    color: var(--fg);
    border-color: var(--accent);
  }
  .arch-frame__open svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @keyframes arch-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (max-width: 520px) {
    .arch-frame__tag--tr {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .arch-frame {
      padding: 28px 8px 10px;
    }
    .arch-frame__screen {
      height: min(66vh, 520px);
    }
    .arch-frame--tall .arch-frame__screen {
      height: min(80vh, 640px);
    }
    .arch-frame--compact .arch-frame__screen {
      height: min(56vh, 460px);
    }
    .arch-index {
      top: 52px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch-frame__loading {
      animation: none;
    }
  }
</style>
