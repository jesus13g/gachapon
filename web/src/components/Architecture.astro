---
// Architecture view: one embedded interactive diagram per section.
// Diagram HTML is generated by the archify skill into public/architecture/<lang>/<slug>.html (see web/README.md).
import Base from '../layouts/Base.astro';
import Hud from './Hud.astro';
import Footer from './Footer.astro';
import { copyFor, langOf } from '../i18n';

const { architecture: a } = copyFor(Astro.currentLocale);
const lang = langOf(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (slug: string) => `${base}/architecture/${lang}/${slug}.html`;
---
<Base title={a.title} description={a.description} page="architecture">
  <Hud page="architecture" />
  <main id="story" class="arch">
    <header class="arch-hero">
      <p class="kicker">{a.kicker}</p>
      <h1>{a.h1}</h1>
      <div class="arch-hero__intro">
        {a.intro.map((t) => <p>{t}</p>)}
      </div>
      <aside class="arch-howto">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M8 7.2v4M8 4.6v.1" /></svg>
        <p><strong>{a.howTo.label}.</strong> {a.howTo.text}</p>
      </aside>
    </header>

    <nav class="arch-index" aria-label={a.indexLabel}>
      <ol>
        {a.sections.map((s) => <li><a href={`#${s.slug}`}>{s.kicker}</a></li>)}
      </ol>
    </nav>

    {a.sections.map((s) => (
      <section class="arch-sec" id={s.slug} aria-labelledby={`${s.slug}-h`}>
        <div class="arch-sec__copy">
          <p class="kicker">{s.kicker}</p>
          <h2 id={`${s.slug}-h`}>{s.h}</h2>
          <p>{s.p}</p>
          <ul>
            {s.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
        <figure class="arch-frame">
          <span class="arch-frame__tag arch-frame__tag--tl">{s.kicker}</span>
          <span class="arch-frame__tag arch-frame__tag--tr">{a.frameLabel}</span>
          <div class="arch-frame__screen">
            <span class="arch-frame__loading" aria-hidden="true">{a.loading}</span>
            <iframe
              src={`${src(s.slug)}?theme=dark&embed=1`}
              title={`${a.diagramTitle}: ${s.h}`}
              loading="lazy"
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
          <a class="arch-frame__open" href={`${src(s.slug)}?theme=dark`} target="_blank" rel="noopener">
            {a.fullscreen}
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5l-6 6M12 9v4a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h4" /></svg>
          </a>
        </figure>
      </section>
    ))}
  </main>
  <Footer />
</Base>

<style>
  /* Architecture page: normal scrolling document on the shared tokens (no pinned stage). */
  .arch {
    position: relative;
    z-index: 9;
    padding: clamp(88px, 12vh, 130px) var(--gutter) clamp(48px, 8vh, 96px);
    max-width: 1480px;
    margin: 0 auto;
  }
  .arch-hero {
    max-width: 52rem;
  }
  .arch-hero h1 {
    margin: 0 0 1.2rem;
    font: 800 clamp(2.6rem, 7vw, 5.6rem) / 0.9 var(--display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .arch-hero__intro p {
    margin: 0 0 0.9rem;
    max-width: 44rem;
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .arch-howto {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 1.6rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    background: rgba(19, 25, 32, 0.7);
  }
  .arch-howto svg {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .arch-howto p {
    margin: 0;
    font: 400 0.82rem / 1.6 var(--mono);
    color: var(--fg-dim);
  }
  .arch-howto strong {
    color: var(--fg);
    font-weight: 600;
  }

  /* Section index: sticky chips under the header */
  .arch-index {
    position: sticky;
    top: 56px;
    z-index: 20;
    margin: 2.4rem calc(var(--gutter) * -1) 0;
    padding: 10px var(--gutter);
    background: linear-gradient(var(--bg) 70%, transparent);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .arch-index::-webkit-scrollbar {
    display: none;
  }
  .arch-index ol {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    width: max-content;
  }
  .arch-index a {
    display: block;
    padding: 5px 11px;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--fg-dim);
    background: rgba(9, 11, 14, 0.7);
    transition: color 0.2s, border-color 0.2s;
  }
  .arch-index a:hover,
  .arch-index a:focus-visible {
    color: var(--fg);
    border-color: var(--accent);
  }

  /* One section per diagram */
  .arch-sec {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    padding-top: clamp(2.6rem, 7vh, 5rem);
    scroll-margin-top: 90px;
  }
  @media (min-width: 1100px) {
    .arch-sec {
      grid-template-columns: minmax(18rem, 26rem) minmax(0, 1fr);
      align-items: start;
    }
    .arch-sec__copy {
      position: sticky;
      top: 120px;
    }
  }
  .arch-sec__copy h2 {
    margin: 0 0 1rem;
    font: 800 clamp(1.9rem, 3.4vw, 3rem) / 0.95 var(--display);
    text-transform: uppercase;
  }
  .arch-sec__copy p:not(.kicker) {
    margin: 0 0 1.1rem;
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .arch-sec__copy ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .arch-sec__copy li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .arch-sec__copy li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  /* Diagram panel: part of the machine, steel frame with an inner glow and mono corner labels */
  .arch-frame {
    position: relative;
    margin: 0;
    padding: 30px 12px 12px;
    border: 1px solid var(--line-hi);
    background: linear-gradient(160deg, var(--steel-1), var(--steel-0));
    box-shadow: inset 0 0 40px rgba(255, 154, 60, 0.06), 0 18px 50px rgba(0, 0, 0, 0.45);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
  }
  .arch-frame__tag {
    position: absolute;
    top: 9px;
    font: 500 0.62rem var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .arch-frame__tag--tl {
    left: 14px;
    color: var(--accent);
  }
  .arch-frame__tag--tr {
    right: 26px;
  }
  .arch-frame__screen {
    position: relative;
    height: min(78vh, 760px);
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.6);
  }
  .arch-frame__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 500 0.72rem var(--mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
    animation: arch-pulse 1.6s ease-in-out infinite;
  }
  .arch-frame__screen iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .arch-frame__open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding: 4px 2px;
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-dim);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .arch-frame__open:hover,
  .arch-frame__open:focus-visible {
    color: var(--fg);
    border-color: var(--accent);
  }
  .arch-frame__open svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @keyframes arch-pulse {
    50% {
      opacity: 0.4;
    }
  }
  @media (max-width: 520px) {
    .arch-frame__tag--tr {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .arch-frame {
      padding: 28px 8px 10px;
    }
    .arch-frame__screen {
      height: min(70vh, 520px);
    }
    .arch-index {
      top: 52px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch-frame__loading {
      animation: none;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
