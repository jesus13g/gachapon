---
// The Gachapon core. Octagonal housing with a bore in the middle where capsules pass.
interface Props { x: number; y: number; s?: number; state?: string; label?: boolean; class?: string; k?: string }
const { x, y, s = 1, state = 'active', label = true, class: cls, k = 'hub' } = Astro.props;
const pts = Array.from({ length: 8 }, (_, i) => { const a = (Math.PI / 4) * i + Math.PI / 8; return `${(Math.cos(a) * 100).toFixed(1)},${(Math.sin(a) * 100).toFixed(1)}`; }).join(' ');
---
<g class:list={['hub', cls]} data-k={k} data-state={state} transform={`translate(${x} ${y}) scale(${s})`}>
  <polygon points={pts} class="steel" style="stroke:var(--c);stroke-opacity:.8;stroke-width:2.5" />
  <g class="spin-slow"><circle r="82" fill="none" stroke="var(--c)" stroke-opacity=".5" stroke-width="2" stroke-dasharray="3 14" /></g>
  <circle r="58" fill="#07090c" stroke="var(--line-hi)" stroke-width="2" />
  {[0, 90, 180, 270].map((a) => <rect x="-3" y="-100" width="6" height="16" fill="var(--line-hi)" transform={`rotate(${a})`} />)}
  {label && <text class="t-lg t-d" y="142" text-anchor="middle" style="font-size:28px;letter-spacing:.2em;fill:var(--fg)">GACHAPON</text>}
</g>
