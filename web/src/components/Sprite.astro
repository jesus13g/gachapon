---
// Shared SVG defs: the capsule, gradients, patterns. Rendered once, referenced with <use>.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-steel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1f2832" />
      <stop offset="1" stop-color="#121820" />
    </linearGradient>
    <pattern id="p-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="10" height="10" fill="#0b0e12" />
      <rect width="4" height="10" fill="#b4bfcc" opacity="0.22" />
    </pattern>
    <marker id="m-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M1 1 L9 5 L1 9 Z" fill="context-stroke" />
    </marker>
    <!-- The capsule: left half takes the state colour, right half is the shell. 120 × 56, centred. -->
    <g id="cap">
      <path class="cap__a" d="M0,-26 H-34 A26,26 0 0 0 -34,26 H0 Z" />
      <path class="cap__b" d="M0,-26 H34 A26,26 0 0 1 34,26 H0 Z" />
      <rect class="cap__seam" x="-1.5" y="-26" width="3" height="52" />
      <path class="cap__hl" d="M-44,-15 H-20" />
    </g>
    <!-- padlock (closed) -->
    <g id="i-lock">
      <rect x="-9" y="-2" width="18" height="14" rx="2" fill="currentColor" />
      <path d="M-5 -2 V-7 a5 5 0 0 1 10 0 V-2" fill="none" stroke="currentColor" stroke-width="2.4" />
    </g>
    <g id="i-key">
      <circle cx="-8" cy="0" r="6" fill="none" stroke="currentColor" stroke-width="2.6" />
      <path d="M-2 0 H14 M9 0 V6 M14 0 V5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    </g>
    <g id="i-gear">
      <circle r="22" fill="none" stroke="currentColor" stroke-width="5" stroke-dasharray="9 5.2" />
      <circle r="15" fill="none" stroke="currentColor" stroke-width="2.4" />
      <circle r="4.5" fill="currentColor" />
    </g>
    <g id="i-check"><path d="M-8 0 L-2 6 L9 -7" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" /></g>
    <g id="i-cross"><path d="M-7 -7 L7 7 M7 -7 L-7 7" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" /></g>
  </defs>
</svg>
