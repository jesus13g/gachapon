---
import '@fontsource/big-shoulders-display/latin-800';
import '@fontsource/big-shoulders-display/latin-900';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
// The h1 renders in Big Shoulders Display 800 (latin); preloading the same asset the @font-face points to avoids a late swap on LCP.
import bsd800 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import '../styles/global.css';
import { copyFor, langs, pathFor } from '../i18n';
import Sprite from '../components/Sprite.astro';
import GradientShaderBg from '../components/ui/GradientShaderBg.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { site, ui } = copyFor(Astro.currentLocale);
const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogAlt,
  type = 'website',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Site verification codes come from repo variables at build time; unset means no meta tag.
const googleVerif = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerif = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const ogImage = new URL(`${base}${image}`, Astro.site).href;
const locale = site.lang === 'es' ? 'es_ES' : 'en_US';
const localeAlt = site.lang === 'es' ? 'en_US' : 'es_ES';
// Stable @ids hang off the English root so both locales describe the same site, author and software.
const root = new URL(pathFor('en'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${root}#website`,
      url: root,
      name: site.name,
      inLanguage: [...langs],
      publisher: { '@id': `${root}#author` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: site.lang,
      isPartOf: { '@id': `${root}#website` },
      about: { '@id': `${root}#software` },
      primaryImageOfPage: ogImage,
    },
    {
      '@type': 'Person',
      '@id': `${root}#author`,
      name: 'jesus13g',
      url: 'https://github.com/jesus13g',
      sameAs: ['https://github.com/jesus13g'],
    },
    {
      '@type': ['SoftwareApplication', 'SoftwareSourceCode'],
      '@id': `${root}#software`,
      name: site.name,
      description,
      url: root,
      image: ogImage,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows (WSL2)',
      codeRepository: site.repo,
      license: 'https://opensource.org/license/mit',
      author: { '@id': `${root}#author` },
    },
  ],
};
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b0e" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {googleVerif && <meta name="google-site-verification" content={googleVerif} />}
    {bingVerif && <meta name="msvalidate.01" content={bingVerif} />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), Astro.site).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en'), Astro.site).href} />}
    <link rel="preload" as="font" type="font/woff2" href={bsd800} crossorigin />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale} />
    {!noindex && <meta property="og:locale:alternate" content={localeAlt} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <script is:inline>
      // Decide the layout before first paint so the cinematic stage never flashes as a stacked page.
      (function () {
        try {
          var m = matchMedia;
          if (m('(min-width: 900px) and (min-height: 540px)').matches && !m('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('is-cinema');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#story">{ui.skip}</a>
    <Sprite />
    <GradientShaderBg />
    <slot />
  </body>
</html>
