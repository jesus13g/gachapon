---
import Base from '../layouts/Base.astro';
import ThreadLayer from '../components/ThreadLayer.astro';
import { acts, site, ui } from '../content/copy.en';
import Act00Boot from '../components/scenes/Act00Boot.astro';
import Act01Problem from '../components/scenes/Act01Problem.astro';
import Act02Roles from '../components/scenes/Act02Roles.astro';
import Act03Bus from '../components/scenes/Act03Bus.astro';
import Act04Locks from '../components/scenes/Act04Locks.astro';
import Act05Modes from '../components/scenes/Act05Modes.astro';
import Act06Control from '../components/scenes/Act06Control.astro';
import Act07Teams from '../components/scenes/Act07Teams.astro';
import Act08Routines from '../components/scenes/Act08Routines.astro';
import Act09Knowledge from '../components/scenes/Act09Knowledge.astro';
import Act10Mcp from '../components/scenes/Act10Mcp.astro';
import Act11Sandbox from '../components/scenes/Act11Sandbox.astro';
import Act12Journal from '../components/scenes/Act12Journal.astro';
import Act13Interfaces from '../components/scenes/Act13Interfaces.astro';
import Act14System from '../components/scenes/Act14System.astro';
import Act15Final from '../components/scenes/Act15Final.astro';
---
<Base>
  <header class="hud">
    <a class="brand" href="#boot" aria-label="Gachapon — top">
      <svg viewBox="0 0 30 18" aria-hidden="true"><path d="M15 1H9a8 8 0 0 0 0 16h6z" fill="#ff9a3c" /><path d="M15 1h6a8 8 0 0 1 0 16h-6z" fill="#f1f0ea" /></svg>
      Gachapon
    </a>
    <nav class="hud__links" aria-label="Project">
      <a href={site.repo} rel="noopener">GitHub</a>
    </nav>
  </header>
  <nav class="rail" aria-label={ui.railLabel}>
    {acts.map((a, i) => <button type="button" aria-label={a.kicker} aria-current={i === 0 ? 'true' : 'false'}><span>{a.kicker}</span></button>)}
  </nav>
  <main id="story" class="story">
    <div class="stage">
      <div class="stage__grid"></div>
      <Act00Boot />
      <Act01Problem />
      <Act02Roles />
      <Act03Bus />
      <Act04Locks />
      <Act05Modes />
      <Act06Control />
      <Act07Teams />
      <Act08Routines />
      <Act09Knowledge />
      <Act10Mcp />
      <Act11Sandbox />
      <Act12Journal />
      <Act13Interfaces />
      <Act14System />
      <Act15Final />
      <ThreadLayer />
      <div class="stage__vignette"></div>
    </div>
  </main>
  <footer class="site-footer">
    <span>{ui.footer}</span>
    <span><a href={site.repo} rel="noopener">GitHub</a> · {site.license}</span>
  </footer>
  <script>
    import '../scripts/main';
  </script>
</Base>
