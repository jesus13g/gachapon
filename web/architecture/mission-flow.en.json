  "cards": [
    {
      "dot": "cyan",
      "title": "Three modes, one pipeline",
      "items": [
        "/mision iterates until the criterion passes or iteraciones run out",
        "/obra runs phases, each with its own criterion and a tree snapshot, and stops every revisar_cada",
        "/rutina is created by a timer, with no planner: a pass closes itself, a failure waits for the user"
      ]
    },
    {
      "dot": "rose",
      "title": "Nobody approves itself",
      "items": [
        "The system runs the criterion with sh -c; an empty criterion is refused at creation and never counts as success",
        "Mutating MCP tools only simulate or propose; the user accepts",
        "A failed routine reaches the planner only after ea trabajo confirmar"
      ]
    },
    {
      "dot": "amber",
      "title": "Hard limits",
      "items": [
        "Sandbox, exclusive worktree semaphore, no web tools",
        "Time limit kills the whole process tree (SIGTERM, then kill); Qwen exits 55 on turn or tool-call limits",
        "Cancelling does not undo what the agent already wrote"
      ]
    }
  ]
