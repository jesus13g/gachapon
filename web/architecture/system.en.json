  "cards": [
    {
      "dot": "rose",
      "title": "Control rules",
      "items": [
        "No agent confirms itself: only the user accepts, irreversible actions need a real TTY",
        "The system runs the success criterion, never the agent; an empty criterion is not success",
        "The executor model must be local; a remote one is valid only for the planner",
        "ea-mcp and the orchestrator only receive the SoloConsulta layer"
      ]
    },
    {
      "dot": "cyan",
      "title": "Roles and agents",
      "items": [
        "Planner formalises and reviews; executor runs verifiable steps; planner ≠ executor",
        "Catalog: Claude Code, Qwen Code, Codex, OpenCode, Antigravity; each role's agent is interchangeable",
        "Teams (spec 019): several agents at once, per-agent queues, own worktree, presence"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local only",
      "items": [
        "ea-mcp :8765 and ea-web :8092 bind 127.0.0.1; ea-web filters the Host header",
        "The desktop app wraps the same panel and needs ea-web running",
        "Only the planner's model may live in the cloud"
      ]
    },
    {
      "dot": "violet",
      "title": "Crate layers",
      "items": [
        "ea-plataforma is the base: no ea-* dependencies, all OS differences live there",
        "ea-ajustes → ea-store → ea-bus / ea-boveda → ea-acciones → binaries",
        "Every crate also reads settings through ea-ajustes and OS paths through ea-plataforma (edges omitted)"
      ]
    }
  ]
}