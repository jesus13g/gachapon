  "cards": [
    {
      "dot": "rose",
      "title": "El diario es append-only",
      "items": [
        "Los triggers events_no_update y events_no_delete hacen RAISE(ABORT) a nivel de motor.",
        "Un evento erróneo se corrige emitiendo otro evento, nunca editando.",
        "events.trabajo guarda el id del trabajo del bus como texto; no hay clave foránea."
      ]
    },
    {
      "dot": "amber",
      "title": "Restricciones de la migración",
      "items": [
        "events.outcome IN (ok, error); propuestas.estado IN (pendiente, aceptada, rechazada), por defecto pendiente.",
        "propuestas.accion_riesgo IN (reversible, irreversible); ejecucion_estado IN (ejecutando, ejecutada, fallida).",
        "CHECK: accion_herramienta y accion_riesgo son ambos NULL o ambos tienen valor.",
        "PRAGMA foreign_keys = ON; la única FK declarada es trabajo_fases.trabajo_id."
      ]
    },
    {
      "dot": "cyan",
      "title": "Índices",
      "items": [
        "events: ts, actor, trabajo, (trabajo, ts).",
        "propuestas(estado), boveda_notas(region), trabajos(estado)."
      ]
    }
  ]
