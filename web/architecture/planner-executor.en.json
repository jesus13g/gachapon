  "cards": [
    {
      "dot": "amber",
      "title": "Where it waits",
      "items": [
        "After ea trabajo crear the planner stops; the job sits in colas/modelo-local until ea-orchestrator polls it",
        "The report waits in colas/claude-code until the user runs /revisar",
        "The planner never loops waiting and never does the executor work"
      ]
    },
    {
      "dot": "rose",
      "title": "Read-only from MCP",
      "items": [
        "ea-mcp only reads the bus: jobs are created and decided with the ea CLI",
        "Mutating MCP tools simulate or propose; only the user accepts, with ea propuestas decidir",
        "The actor comes from clientInfo.name and the current role, never from an argument"
      ]
    },
    {
      "dot": "emerald",
      "title": "Journal",
      "items": [
        "Every bus event and every MCP call is appended to the SQLite events table",
        "The table is append-only by triggers: a mistake is fixed with a new event"
      ]
    }
  ]
