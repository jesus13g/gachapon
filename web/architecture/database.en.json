  "cards": [
    {
      "dot": "rose",
      "title": "Journal is append-only",
      "items": [
        "Triggers events_no_update and events_no_delete RAISE(ABORT) at engine level.",
        "A wrong event is corrected by emitting another event, never by editing.",
        "events.trabajo holds the bus job id as text; there is no foreign key."
      ]
    },
    {
      "dot": "amber",
      "title": "Constraints in the migration",
      "items": [
        "events.outcome IN (ok, error); propuestas.estado IN (pendiente, aceptada, rechazada), default pendiente.",
        "propuestas.accion_riesgo IN (reversible, irreversible); ejecucion_estado IN (ejecutando, ejecutada, fallida).",
        "CHECK: accion_herramienta and accion_riesgo are both NULL or both set.",
        "PRAGMA foreign_keys = ON; the only declared FK is trabajo_fases.trabajo_id."
      ]
    },
    {
      "dot": "cyan",
      "title": "Indexes",
      "items": [
        "events: ts, actor, trabajo, (trabajo, ts).",
        "propuestas(estado), boveda_notas(region), trabajos(estado)."
      ]
    }
  ]
