# Plantilla de referencia con la ruta del repo. `ea servicios instalar` genera la unidad
# con la ruta real de los binarios (sin %h/Proyectos/... fijo).
[Unit]
Description=Servidor de herramientas MCP del ecosistema de asistente
After=network.target

[Service]
Type=simple
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea-mcp
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
