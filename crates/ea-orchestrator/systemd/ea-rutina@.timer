[Unit]
Description=Disparador temporal de la rutina '%i' del ecosistema de asistente

[Timer]
# Plantilla genérica: cada rutina necesita su propio horario, así que este
# fichero no se instala tal cual. Cópialo como
# ~/.config/systemd/user/ea-rutina@<slug>.timer (systemd prioriza el
# fichero de instancia concreta sobre esta plantilla) y ajusta OnCalendar=.
# ea_programar_rutina (ficha de la rutina en ea-web, o propuesta por MCP)
# escribe ese fichero con este mismo contenido y lo activa.
# Ejemplo: todos los días a las 08:00.
OnCalendar=*-*-* 08:00:00
# Esta máquina alterna con Windows y rara vez está en Linux a esa hora, así
# que además se dispara una sola vez, 10 min después de arrancar la sesión
# (retraso para no competir con el arranque del escritorio). No es
# recuperar ejecuciones perdidas: por eso Persistent sigue en false (dec. 13).
OnStartupSec=10min
Persistent=false

[Install]
WantedBy=timers.target
