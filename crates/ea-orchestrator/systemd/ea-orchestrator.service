# Plantilla de referencia con la ruta del repo. `ea servicios instalar` genera la unidad
# con la ruta real de los binarios (sin %h/Proyectos/... fijo).
[Unit]
Description=Orquestador de rutinas del ecosistema de asistente
After=network.target ea-mcp.service
Wants=ea-mcp.service

[Service]
Type=simple
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea-orchestrator
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
