[Unit]
Description=Orquestador de rutinas del ecosistema de asistente
After=network.target ea-proxy.service ea-mcp.service
Wants=ea-proxy.service ea-mcp.service

[Service]
Type=simple
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea-orchestrator
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
