[Unit]
Description=Dispara la rutina '%i' del ecosistema de asistente

[Service]
Type=oneshot
# No ejecuta la rutina: solo encola una tarea (§10.1 de la especificación).
# El orquestador residente (ea-orchestrator.service) la recoge cuando puede.
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea rutinas encolar %i
