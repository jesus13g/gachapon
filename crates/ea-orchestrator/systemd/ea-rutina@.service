# Plantilla de referencia con la ruta del repo. `ea servicios instalar` genera la unidad
# con la ruta real de los binarios (sin %h/Proyectos/... fijo).
[Unit]
Description=Dispara la rutina '%i' del ecosistema de asistente

[Service]
Type=oneshot
# No ejecuta la rutina: solo crea el trabajo en el bus (§10.1 de la especificación).
# El orquestador residente (ea-orchestrator.service) la recoge cuando puede.
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea rutina lanzar %i
