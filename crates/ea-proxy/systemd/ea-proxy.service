[Unit]
Description=Proxy de inferencia local del ecosistema de asistente
After=network.target llama-server.service ea-mcp.service
Wants=llama-server.service ea-mcp.service

[Service]
Type=simple
ExecStart=%h/Proyectos/ecosistema-asistente/target/release/ea-proxy
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
