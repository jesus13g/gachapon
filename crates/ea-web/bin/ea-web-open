#!/bin/bash
# Abre el panel de ea-web como web app en el escritorio 4. Si la ventana ya
# existe, solo enfoca el escritorio. La clase de ventana de Chromium sale del
# host (localhost → chrome-localhost__-Default); no usar 127.0.0.1, que ya es
# la clase del tutor de Hyprland (regla en ~/.config/hypr/hyprland.lua).
# El puerto: EA_WEB_PORT o red.puerto_web de los ajustes (8092 si no hay `ea`).
# La clave de sesión que ea-web deja al arrancar en $XDG_RUNTIME_DIR/ea-web/clave
# viaja en el fragmento (#clave=…), que no llega al servidor ni cambia la clase
# de la ventana; la página la guarda y la quita de la barra de direcciones.
PORT="${EA_WEB_PORT:-$("$HOME/Proyectos/ecosistema-asistente/target/release/ea" ajustes obtener red.puerto_web 2>/dev/null || echo 8092)}"
URL="http://localhost:${PORT}/"
CLAVE_FICHERO="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ea-web/clave"
CLASS="chrome-localhost__-Default"
WORKSPACE=4

if hyprctl -j clients | grep -q "\"class\": \"$CLASS\""; then
  exec hyprctl dispatch "hl.dsp.focus({ workspace = \"$WORKSPACE\" })" >/dev/null
fi

# Al iniciar sesión el servicio puede tardar un poco en arrancar.
for _ in $(seq 1 60); do
  curl -sf -m 2 -o /dev/null "${URL}api/estado" && break
  sleep 1
done
# ea-web escribe la clave justo después de empezar a escuchar.
for _ in $(seq 1 5); do
  [ -s "$CLAVE_FICHERO" ] && break
  sleep 1
done
if [ -r "$CLAVE_FICHERO" ] && CLAVE="$(cat "$CLAVE_FICHERO")" && [ -n "$CLAVE" ]; then
  exec omarchy-launch-webapp "${URL}#clave=${CLAVE}"
fi
echo "ea-web-open: no encuentro la clave de sesión en $CLAVE_FICHERO; el panel se abre en solo lectura" >&2
exec omarchy-launch-webapp "$URL"
